<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UniversalVectorDBConnector</RootNamespace>
    <AssemblyName>UniversalVectorDBConnector</AssemblyName>
    <Version>0.1.0</Version>
    <!-- No .pdb in the upload ZIP: it is sent inline as base64, so keep it small. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OutSystems.ExternalLibraries.SDK" Version="1.7.0" />
    <!-- Logging (Microsoft.Extensions.Logging.Abstractions) left out of 0.1 to keep the upload small; planned for 0.2. -->
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\icon.png" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="UniversalVectorDBConnector.UnitTests" />
  </ItemGroup>
</Project>
